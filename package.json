{
  "name": "lets-shoot-the-duck",
  "version": "1.0.0",
  "private": true,
  "description": "LET'S SHOOT THE DUCK - a 2D arcade parody web game",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "encode": "node scripts/encode-questions.js",
    "build": "node scripts/encode-questions.js && node scripts/check.js",
    "loadtest": "node scripts/loadtest.js"
  }
}
