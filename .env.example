# Copy to .env (never commit real values). All variables are server-side only.

# Secret used to sign game session tokens (min 16 chars). REQUIRED in production.
SCORE_SECRET=replace-with-a-long-random-string

# Upstash Redis REST credentials (production database).
# The Vercel Marketplace Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional
# PORT=3000
# TRUST_PROXY=1            # trust X-Forwarded-For (set when behind a reverse proxy)
# MIN_GAME_SECONDS=25      # minimum plausible game duration for score submission
# RATE_LIMIT_DISABLED=1    # testing only
