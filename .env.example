# Copy to .env for local development (never commit real values). All variables are server-side only.
# On Vercel, set these in Project → Settings → Environment Variables instead (Vercel does not read .env).

# Secret used to sign game session tokens. At least 16 characters. REQUIRED in production.
SCORE_SECRET=replace-with-a-long-random-string

# Redis connection string (redis:// or rediss://). Leave empty locally to store scores in ./data/scores.json.
REDIS_URL=

# Optional
# PORT=3000
# TRUST_PROXY=1            # trust X-Forwarded-For (set when behind a reverse proxy)
# MIN_GAME_SECONDS=25      # minimum plausible game duration for score submission
# RATE_LIMIT_DISABLED=1    # testing only
